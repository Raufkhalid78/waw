# ==============================================================================
# Waw (واو) — Marketplace Environment Configuration
# ==============================================================================

# Node Environment & Ports
NODE_ENV=development
PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Supabase (Database & Auth)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:your-db-password@db.your-supabase-project.supabase.co:5432/postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Upstash Redis (Production - Cloud-hosted, serverless)
UPSTASH_REDIS_REST_URL=rediss://your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Typesense Search Engine
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=xyz123WawTypesenseSecretKey2026

# Payment Gateway: Safepay (Phase 1 - Primary)
SAFEPAY_API_KEY=sec_sandbox_your_safepay_key
SAFEPAY_SECRET_KEY=your_safepay_secret_key
SAFEPAY_WEBHOOK_SECRET=your_safepay_webhook_secret
SAFEPAY_ENVIRONMENT=sandbox

# Payment Gateway: PayFast (Phase 2 - Wallets + Split Payouts)
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_SECURED_KEY=your_secured_key
PAYFAST_ENVIRONMENT=sandbox

# Raast P2M Merchant Configuration
RAAST_MERCHANT_ALIAS=waw.market@hbl
RAAST_MERCHANT_NAME=Waw Online Shopping PK
RAAST_MERCHANT_CITY=Lahore

# WhatsApp Business API / Twilio Verify
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid
# Alternative: Direct Meta Cloud API
META_WHATSAPP_TOKEN=your_meta_system_user_token
META_WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Couriers (Pakistan)
POSTEX_API_TOKEN=your_postex_token
TRAX_API_KEY=your_trax_key
LEOPARDS_API_KEY=your_leopards_key
TCS_CLIENT_ID=your_tcs_id
TCS_SECRET=your_tcs_secret

# Marketplace Rules & Pricing Policies
DEFAULT_COMMISSION_PERCENTAGE=10
COD_HANDLING_FEE_PKR=100
FREE_DELIVERY_THRESHOLD_PKR=5000
BASE_SHIPPING_FEE_PKR=200

# Business Contact
WHATSAPP_NUMBER=+923001234567
NEXT_PUBLIC_WHATSAPP_NUMBER=+923001234567

# ─── Web App Public ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=https://waw.com.pk
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=+923001234567
NEXT_PUBLIC_TYPESENSE_HOST=localhost
NEXT_PUBLIC_TYPESENSE_PORT=8108
NEXT_PUBLIC_TYPESENSE_PROTOCOL=http
NEXT_PUBLIC_TYPESENSE_API_KEY=xyz123WawTypesenseSecretKey2026

# ─── PostEx XPay (Visa/Mastercard/PayPak + JazzCash/Easypaisa) ──────────────
POSTEX_XPAY_BASE_URL=https://xpay.postexglobal.com/api
POSTEX_XPAY_MERCHANT_ID=your_xpay_merchant_id
POSTEX_XPAY_TOKEN=your_xpay_token
POSTEX_XPAY_SECRET_KEY=your_xpay_secret_key

# ─── Admin App ───────────────────────────────────────────────────────────────
ADMIN_PORT=3002

# ─── Seller App ──────────────────────────────────────────────────────────────
SELLER_PORT=3003

# ─── Typesense (Shared for Search) ──────────────────────────────────────────
TYPESENSE_COLLECTION_PREFIX=waw_

# ─── OpenRouter AI ──────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=mistralai/mistral-7b-instruct
OPENROUTER_DAILY_REQUEST_LIMIT=1000

# ─── Sentry Error Tracking ─────────────────────────────────────────────────
SENTRY_DSN=your_sentry_dsn
