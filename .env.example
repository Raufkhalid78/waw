# ==============================================================================
# Waw (واو) — Marketplace Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Node Environment & Ports
NODE_ENV=development
PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Supabase (Database & Auth)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Redis (TCP — required by BullMQ queues and the rate limiter; Upstash exposes
# this on the same dashboard under "Connect via Redis")
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Upstash Redis (REST — used for sessions/OTP; required in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Typesense Search Engine
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=

# Raast P2M Merchant Configuration
RAAST_MERCHANT_ALIAS=waw.market@hbl
RAAST_MERCHANT_NAME=Waw Online Shopping PK
RAAST_MERCHANT_CITY=Lahore
RAAST_WEBHOOK_SECRET=

# API Security Secrets (generate with: openssl rand -base64 48)
JWT_SECRET=
GUEST_TOKEN_SECRET=

# DEV ONLY: bypass WhatsApp OTP with a fixed test code. Never enable in production.
ALLOW_TEST_OTP=false

# Firebase Cloud Messaging (push notifications — optional)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# WhatsApp Business API / Twilio Verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# Couriers (Pakistan)
POSTEX_API_TOKEN=
POSTEX_API_BASE=https://api.postex.pk/services/integration/api

# Public base URL of the API server (required in production)
# Used for provider webhooks (XPay callbacks) and buyer-facing return URLs.
PUBLIC_API_URL=http://localhost:4000

# Marketplace Rules & Pricing Policies
DEFAULT_COMMISSION_PERCENTAGE=10
COD_HANDLING_FEE_PKR=100
FREE_DELIVERY_THRESHOLD_PKR=5000
BASE_SHIPPING_FEE_PKR=200

# Business Contact
WHATSAPP_NUMBER=+923001234567
NEXT_PUBLIC_WHATSAPP_NUMBER=+923001234567

# ─── Web App Public ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=https://waw.com.pk
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_TYPESENSE_HOST=localhost
NEXT_PUBLIC_TYPESENSE_PORT=8108
NEXT_PUBLIC_TYPESENSE_PROTOCOL=http
NEXT_PUBLIC_TYPESENSE_API_KEY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=development

# ─── PostEx XPay (Visa/Mastercard/PayPak + JazzCash/Easypaisa) ──────────────
POSTEX_XPAY_BASE_URL=https://xpay.postexglobal.com/api
POSTEX_XPAY_MERCHANT_ID=
POSTEX_XPAY_TOKEN=
POSTEX_XPAY_SECRET_KEY=

# ─── Admin App ───────────────────────────────────────────────────────────────
ADMIN_PORT=3002

# ─── Seller App ──────────────────────────────────────────────────────────────
SELLER_PORT=3003

# ─── Typesense (Shared for Search) ──────────────────────────────────────────
TYPESENSE_COLLECTION_PREFIX=waw_

# ─── OpenRouter AI ──────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-7b-instruct
OPENROUTER_DAILY_REQUEST_LIMIT=1000

# ─── Sentry Error Tracking ─────────────────────────────────────────────────
SENTRY_DSN=

# ─── SendGrid Email Service ──────────────────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=noreply@waw.com.pk
EMAIL_FROM_NAME=Waw

# ─── Docker Compose (Local Dev Services) ─────────────────────────────────
POSTGRES_DB=waw_db
POSTGRES_USER=waw_user
POSTGRES_PASSWORD=change_me_in_production
TYPESENSE_API_KEY=change_me_in_production

# ─── Admin Seed Password (change before production) ─────────────────────
ADMIN_PASSWORD=ChangeMeInProduction!