generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
  SUPPORT
}

enum StoreStatus {
  PENDING_KYC
  ACTIVE
  SUSPENDED
  REJECTED
}

enum SellerType {
  FIRST_PARTY
  THIRD_PARTY
}

enum PaymentMethod {
  SAFEPAY_CARD
  SAFEPAY_RAAST
  PAYFAST_WALLET_JAZZCASH
  PAYFAST_WALLET_EASYPAISA
  PAYFAST_CARD
  COD
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  COD_PENDING
  COD_COLLECTED
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum CourierProvider {
  POSTEX
  TRAX
  LEOPARDS
  TCS
  WAW_FLEET
}

enum PayoutStatus {
  SCHEDULED
  PROCESSING
  PAID
  HELD
  FAILED
}

model Profile {
  id                  String   @id // Matches Supabase auth.users.id
  fullName            String
  phone               String   @unique
  email               String?  @unique
  role                UserRole @default(BUYER)
  avatarUrl           String?
  isWhatsAppVerified  Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  stores              Store[]
  orders              Order[]
  reviews             Review[]
}

model Store {
  id                       String      @id @default(uuid())
  ownerId                  String
  owner                    Profile     @relation(fields: [ownerId], references: [id])
  name                     String
  slug                     String      @unique
  description              String?
  logoUrl                  String?
  bannerUrl                String?
  sellerType               SellerType  @default(THIRD_PARTY)
  status                   StoreStatus @default(PENDING_KYC)
  commissionRatePercentage Int         @default(10)
  cnicNumber               String?
  bankAccountTitle         String?
  bankAccountNumber        String?
  bankName                 String?
  city                     String
  address                  String
  ratingAverage            Float       @default(0.0)
  ratingCount              Int         @default(0)
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  products                 Product[]
  orderItems               OrderItem[]
  payouts                  Payout[]
}

model Category {
  id          String     @id @default(uuid())
  name        String
  nameUrdu    String?
  slug        String     @unique
  iconUrl     String?
  parentId    String?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  products    Product[]
  createdAt   DateTime   @default(now())
}

model Product {
  id                 String           @id @default(uuid())
  storeId            String?          // null = First party (Waw)
  store              Store?           @relation(fields: [storeId], references: [id])
  categoryId         String
  category           Category         @relation(fields: [categoryId], references: [id])
  title              String
  titleUrdu          String?
  slug               String           @unique
  description        String
  descriptionUrdu    String?
  isFirstParty       Boolean          @default(false)
  isFeatured         Boolean          @default(false)
  isSponsored        Boolean          @default(false)
  basePricePkr       Int
  compareAtPricePkr  Int?
  costPricePkr       Int?             // For first-party inventory tracking
  images             String[]
  ratingAverage      Float            @default(0.0)
  ratingCount        Int              @default(0)
  soldCount          Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  variants           ProductVariant[]
  orderItems         OrderItem[]
  reviews            Review[]
}

model ProductVariant {
  id                 String      @id @default(uuid())
  productId          String
  product            Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                String      @unique
  title              String
  pricePkr           Int
  compareAtPricePkr  Int?
  stockQuantity      Int         @default(0)
  attributes         Json        // { size: "42", color: "Blue" }
  imageUrl           String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  orderItems         OrderItem[]
}

model Order {
  id               String          @id @default(uuid())
  orderNumber      String          @unique
  buyerId          String
  buyer            Profile         @relation(fields: [buyerId], references: [id])
  buyerName        String
  buyerPhone       String
  shippingAddress  String
  shippingCity     String
  shippingProvince String
  subtotalPkr      Int
  shippingFeePkr   Int             @default(200)
  codFeePkr        Int             @default(0)
  discountPkr      Int             @default(0)
  totalPkr         Int
  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus   @default(PENDING)
  orderStatus      OrderStatus     @default(PENDING)
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  items            OrderItem[]
  shipments        Shipment[]
  payments         Payment[]
}

model OrderItem {
  id                 String          @id @default(uuid())
  orderId            String
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String
  product            Product         @relation(fields: [productId], references: [id])
  variantId          String?
  variant            ProductVariant? @relation(fields: [variantId], references: [id])
  storeId            String?         // null = First party (Waw)
  store              Store?          @relation(fields: [storeId], references: [id])
  sellerType         SellerType      @default(THIRD_PARTY)
  unitPricePkr       Int
  quantity           Int
  totalPricePkr      Int
  wawCommissionPkr   Int             @default(0)
  sellerPayoutPkr    Int
  status             OrderStatus     @default(PENDING)
  shipmentId         String?
  shipment           Shipment?       @relation(fields: [shipmentId], references: [id])
  createdAt          DateTime        @default(now())
}

model Shipment {
  id                    String          @id @default(uuid())
  orderId               String
  order                 Order           @relation(fields: [orderId], references: [id])
  courier               CourierProvider
  trackingNumber        String          @unique
  status                OrderStatus     @default(PENDING)
  isCod                 Boolean         @default(false)
  codAmountPkr          Int             @default(0)
  courierCostPkr        Int             @default(0)
  estimatedDeliveryDate DateTime?
  trackingUrl           String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  orderItems            OrderItem[]
}

model Payment {
  id               String        @id @default(uuid())
  orderId          String
  order            Order         @relation(fields: [orderId], references: [id])
  amountPkr        Int
  paymentMethod    PaymentMethod
  status           PaymentStatus @default(PENDING)
  gatewayReference String?       // Safepay token, PayFast transaction id
  rawResponse      Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Payout {
  id            String       @id @default(uuid())
  storeId       String
  store         Store        @relation(fields: [storeId], references: [id])
  amountPkr     Int
  status        PayoutStatus @default(SCHEDULED)
  bankReference String?
  scheduledFor  DateTime     @default(now())
  settledAt     DateTime?
  createdAt     DateTime     @default(now())
}

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     Profile  @relation(fields: [buyerId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model PlatformSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}
