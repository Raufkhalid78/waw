# ==============================================================================
# WAW API — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Node Environment
NODE_ENV=development
PORT=4000

# Supabase (Database & Auth)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Security & JWT
JWT_SECRET=
ALLOW_TEST_OTP=false

# Redis (Upstash for production, local for development)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Typesense Search
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=

# PostEx Logistics (Courier)
POSTEX_API_BASE=https://api.postex.pk/services/integration/api
POSTEX_API_TOKEN=

# Bank Alfalah — Alfa Payment Gateway (APG)
APG_ENV=sandbox
APG_MERCHANT_ID=
APG_STORE_ID=
APG_MERCHANT_USERNAME=
APG_MERCHANT_PASSWORD=
APG_MERCHANT_HASH=
APG_KEY1=
APG_KEY2=

# WhatsApp / Twilio (OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# Raast P2M
RAAST_MERCHANT_ALIAS=waw.market@hbl
RAAST_MERCHANT_NAME=Waw Online Shopping PK
RAAST_MERCHANT_CITY=Lahore
RAAST_WEBHOOK_SECRET=

# Marketplace Economics (PKR)
FREE_DELIVERY_THRESHOLD_PKR=5000
DEFAULT_COD_FEE_PKR=100
BASE_SHIPPING_FEE_PKR=200
DEFAULT_COMMISSION_PERCENTAGE=10

# OpenRouter AI
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-7b-instruct
OPENROUTER_DAILY_REQUEST_LIMIT=1000

# Sentry Error Tracking
SENTRY_DSN=

# COD remittance polling - enable ONLY after confirming the PostEx remittance endpoint
POSTEX_REMITTANCE_ENABLED=false

# COD remittance polling - enable ONLY after confirming the PostEx remittance endpoint
POSTEX_REMITTANCE_ENABLED=false
