# ==============================================================================
# Waw (واو) — Staging Environment Configuration
# ==============================================================================
# Copy this file to .env.staging and fill in real values.
# This mirrors production configuration for pre-launch validation.

NODE_ENV=production
PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001
SELLER_PORT=3003
CORS_ORIGIN=https://staging.waw.com.pk,https://staging-admin.waw.com.pk,https://staging-seller.waw.com.pk

# ─── Supabase (Staging Project) ──────────────────────────────────────────────
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# ─── Redis (Staging) ─────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_staging

# ─── Typesense (Staging) ─────────────────────────────────────────────────────
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=change_me_staging

# ─── Raast (Sandbox) ─────────────────────────────────────────────────────────
RAST_MERCHANT_ALIAS=staging.waw@hbl
RAAST_MERCHANT_NAME=Waw Staging
RAAST_MERCHANT_CITY=Lahore
RAAST_WEBHOOK_SECRET=change_me_staging

# ─── WhatsApp / Twilio (Sandbox) ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# ─── PostEx (Sandbox) ────────────────────────────────────────────────────────
POSTEX_API_TOKEN=
POSTEX_XPAY_BASE_URL=https://sandbox.xpay.postexglobal.com/api
POSTEX_XPAY_MERCHANT_ID=
POSTEX_XPAY_TOKEN=
POSTEX_XPAY_SECRET_KEY=

# ─── Marketplace Rules ───────────────────────────────────────────────────────
DEFAULT_COMMISSION_PERCENTAGE=10
COD_HANDLING_FEE_PKR=100
FREE_DELIVERY_THRESHOLD_PKR=5000
BASE_SHIPPING_FEE_PKR=200

# ─── Business Contact ────────────────────────────────────────────────────────
WHATSAPP_NUMBER=+923001234567
NEXT_PUBLIC_WHATSAPP_NUMBER=+923001234567

# ─── Web App Public ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=https://api.staging.waw.com.pk
NEXT_PUBLIC_SITE_URL=https://staging.waw.com.pk
NEXT_PUBLIC_WEB_URL=https://staging.waw.com.pk
NEXT_PUBLIC_TYPESENSE_HOST=typesense
NEXT_PUBLIC_TYPESENSE_PORT=8108
NEXT_PUBLIC_TYPESENSE_PROTOCOL=http
NEXT_PUBLIC_TYPESENSE_API_KEY=

# ─── OpenRouter AI ──────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-7b-instruct
OPENROUTER_DAILY_REQUEST_LIMIT=500

# ─── Sentry (Staging DSN) ───────────────────────────────────────────────────
SENTRY_DSN=

# ─── SendGrid ────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=staging@waw.com.pk
EMAIL_FROM_NAME=Waw Staging

# ─── Docker Compose ──────────────────────────────────────────────────────────
POSTGRES_DB=waw_staging
POSTGRES_USER=waw_staging
POSTGRES_PASSWORD=change_me_staging
TYPESENSE_API_KEY=change_me_staging

# ─── Admin Seed Password ────────────────────────────────────────────────────
ADMIN_PASSWORD=StagingAdmin123!
